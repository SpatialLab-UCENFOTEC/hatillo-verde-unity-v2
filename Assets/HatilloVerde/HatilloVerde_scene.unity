  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1162314785}
    m_Modifications:
    - target: {fileID: 692032097840932069, guid: e26e7da7c9ff2b74dade79479e513763, type: 3}
      propertyPath: audioURL
      value: https://hatillo-verde-cenfotec.s3.us-east-2.amazonaws.com/content/hatillo-verde/02_coyote.mp3
      objectReference: {fileID: 0}
    - target: {fileID: 692032097840932069, guid: e26e7da7c9ff2b74dade79479e513763, type: 3}
      propertyPath: description
      value: "Al requerir de territorios amplios, se debe reconocer que su h\xE1bitat
        ha sido gravemente fragmentado por la infraestructura urbana y la urbanizaci\xF3n,
        por lo que es muy importante la rehabilitaci\xF3n de h\xE1bitats con un enfoque
        de mejora en la conectividad funcional para la biodiversidad. Adem\xE1s,
        la disrupci\xF3n en la cadena alimenticia que provoca la urbanizaci\xF3n
        provoca que estos animales no tengan suficientes presas. "
      objectReference: {fileID: 0}
    - target: {fileID: 1352415741936981110, guid: e26e7da7c9ff2b74dade79479e513763, type: 3}
